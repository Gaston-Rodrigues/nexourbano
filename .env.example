# Copiá este archivo con el nombre ".env" (ver GUIA_PASO_A_PASO.md).
# Estos valores son de PRÁCTICA, para tu PC. El archivo .env real NO se sube a GitHub.
MYSQL_ROOT_PASSWORD=nexo_mysql_2026
MINIO_ROOT_USER=nexo
MINIO_ROOT_PASSWORD=nexo_minio_2026
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexo_neo4j_2026
# Direcciones desde tu PC (puertos que publica docker-compose.yml)
