// grafo.cypher - M13: grafo social de NexoUrbano (generado por generar_grafo_cypher.py)
// Nodos: Rider, Interes, Estacion
// Relaciones: AMIGO_DE, VIAJO_CON, LE_GUSTA, SALE_DE
// AMIGO_DE se guarda en una dirección, pero se consulta sin dirección (es simétrica).
// SALE_DE se deduce de viajo_con: si dos riders viajaron juntos desde una estación,
// cada uno sale de esa estación (viajes = suma de los viajes en común desde ahí).

// Empezar de cero para poder repetir el script
MATCH (n) DETACH DELETE n;
CREATE CONSTRAINT rider_id IF NOT EXISTS FOR (r:Rider) REQUIRE r.rider_id IS UNIQUE;
CREATE CONSTRAINT estacion_id IF NOT EXISTS FOR (e:Estacion) REQUIRE e.station_id IS UNIQUE;
CREATE CONSTRAINT interes_nombre IF NOT EXISTS FOR (i:Interes) REQUIRE i.nombre IS UNIQUE;

